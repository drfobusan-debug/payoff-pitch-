# Private credentials for the NBA engine (copied to ~/.nba_engine/engine.env, chmod 600).
# /etc/engine.env is read first; anything set here overrides it.
# The Odds API key is shared with the MLB, CFB, NFL and NHL engines.
THE_ODDS_API_KEY=
# NBAE_DATA_DIR=$HOME/.nba_engine
# NBAE_STATE_SYNC=1
# Daily card email (same Gmail App Password the MLB and NFL engines use).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# NBAE_EMAIL_TO=
