# Private credentials for the CBB engine (copied to ~/.cbb_engine/engine.env, chmod 600).
# /etc/engine.env is read first; anything set here overrides it.
# The Odds API key is shared with the MLB, CFB, NFL, NHL and NBA engines.
THE_ODDS_API_KEY=
