# ENGINE_RUNTIME_DIR=$HOME/.engine_runtime    # quote shards, pass logs, shared credit ledger
# CBBE_EVENT_MARKETS=0    # per-event markets stay off until the written budget allows them
# CBBE_DRY_RUN=0
