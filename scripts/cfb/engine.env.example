# College-football engine credentials for the desktop shortcuts and the
# hands-off daily schedule (launchd/cron). Copy this to ~/.cfb_engine/engine.env
# (the shortcut/schedule installers do that for you) and fill in your values.
# launchd and cron do NOT read your shell profile, so the scheduled jobs can
# only email if the keys live in this file (or in /etc/engine.env).
#
# Keep this file private: chmod 600 ~/.cfb_engine/engine.env. Never commit it.

# --- data feeds ---
# CollegeFootballData API key: https://collegefootballdata.com/key
CFBD_API_KEY=
# The Odds API key: https://the-odds-api.com  (ODDS_API_KEY also accepted)
THE_ODDS_API_KEY=

# --- email delivery (Gmail SMTP by default) ---
# The Gmail address that sends the card/audit package.
GMAIL_USER=
# A Gmail App Password (16 chars), NOT your normal password:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Where the daily card and nightly audit are emailed (defaults to GMAIL_USER).
CFBE_EMAIL_TO=

# --- optional: non-Gmail SMTP server (leave blank to use Gmail) ---
# SMTP_SERVER=
# SMTP_USER=
# SMTP_PASS=
