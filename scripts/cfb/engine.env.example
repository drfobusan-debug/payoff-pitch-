# College-football engine credentials for the desktop shortcuts and the
# hands-off daily schedule (launchd/cron). Copy this to ~/.cfb_engine/engine.env
# (the shortcut/schedule installers do that for you) and fill in your values.
# launchd and cron do NOT read your shell profile, so the scheduled jobs can
# only email if the keys live in this file (or in /etc/engine.env).
#
# Keep this file private: chmod 600 ~/.cfb_engine/engine.env. Never commit it.

# --- data feeds ---
# CollegeFootballData API key: https://collegefootballdata.com/key
# CFBD bills by the call (free tier: 1,000/month, Tier 2: 30,000). Responses are
# cached under ~/.cfb_engine/cache/cfbd so a daily schedule does not re-buy the
# same season data; CFBE_CFBD_CACHE_TTL=<seconds> widens the default 6h window
# for the weekly aggregates, and CFBE_CFBD_CACHE=0 disables caching entirely.
CFBD_API_KEY=
# The Odds API key: https://the-odds-api.com  (ODDS_API_KEY also accepted)
THE_ODDS_API_KEY=

# --- email delivery (Gmail SMTP by default) ---
# The Gmail address that sends the card/audit package.
GMAIL_USER=
# A Gmail App Password (16 chars), NOT your normal password:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Where the daily card and nightly audit are emailed (defaults to GMAIL_USER).
CFBE_EMAIL_TO=

# --- optional: selection guards ---
# Moneyline dogs longer than +200 are refused by default: a long price turns a
# small probability error into a large EV error, and model-versus-price is the
# weakest input this engine has on the moneyline. Refusals are graded as a screen
# in the audit's probation table, so the ledger can argue it back.
#   CFBE_PRICE_BAND_GAME_ML=0     stop refusing them (measure only)
#   CFBE_PRICE_MAX_GAME_ML=300    move the ceiling instead of removing it
#   CFBE_PRICE_MIN_GAME_ML=-250   also refuse short favourites (ships off)
# Nothing is refused on the spread or totals board; CFBE_PRICE_BAND=1 arms those
# too, at -250/+200.

# --- optional: non-Gmail SMTP server (leave blank to use Gmail) ---
# SMTP_SERVER=
# SMTP_USER=
# SMTP_PASS=
