# NFL engine credentials for the hands-off weekly schedule (launchd) and the
# double-click launcher. Copy this to ~/.nfl_engine/engine.env (the schedule
# installer does that for you) and fill in your values. launchd does NOT read
# your shell profile, so the scheduled jobs can only email if the keys live in
# this file (or in /etc/engine.env, or in ~/.mlb_engine/engine.env -- all three
# are read, so one file can serve every engine on the machine).
#
# Keep this file private: chmod 600 ~/.nfl_engine/engine.env. Never commit it.

# --- data feeds ---
# The Odds API key: https://the-odds-api.com  (ODDS_API_KEY also accepted).
# The only paid feed the NFL engine uses; nflverse and ESPN are free.
THE_ODDS_API_KEY=

# --- email delivery (Gmail SMTP by default) ---
# The Gmail address that sends the weekly package.
GMAIL_USER=
# A Gmail App Password (16 chars), NOT your normal password:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Where the weekly card is emailed (falls back to MLBE_EMAIL_TO, then GMAIL_USER).
NFLE_EMAIL_TO=

# --- optional: non-Gmail SMTP server (leave blank to use Gmail) ---
# NFLE_SMTP_HOST=
# NFLE_SMTP_PORT=
